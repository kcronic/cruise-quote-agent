{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--user-data-dir",
        "${HOME}/.pandp-agent/browser-profile",
        "--viewport-size",
        "1280x900",
        "--config",
        "playwright-config.json"
      ]
    }
  }
}
